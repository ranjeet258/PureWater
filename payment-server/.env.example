# Razorpay TEST mode credentials (Dashboard -> Settings -> API Keys, with Test Mode on)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Long random string shared with the ESP32 (firmware secrets.h)
DEVICE_TOKEN=replace_with_a_long_random_token
PORT=3000
AMOUNT_PAISE=500
